# Copy to .env and adjust:   cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed.
# All values are optional; docker-compose.yml has safe local defaults.

# Local database password (only reachable inside the compose network).
POSTGRES_PASSWORD=change-me-local-only

APP_VERSION=1.0.0-local
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=900

# Only needed for the commercial Open-Meteo API. Leave empty for the free API.
WEATHER_API_KEY=

# Grafana admin password for the local monitoring stack.
GRAFANA_ADMIN_PASSWORD=change-me

# Running the app WITHOUT Docker against a local Postgres (make run):
# DATABASE_URL=postgresql://weatherwatch:change-me-local-only@localhost:5432/weatherwatch
